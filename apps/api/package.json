{
  "name": "@k0ii/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "poll": "bun --env-file=../../.env src/jobs/scheduler.ts",
    "db:generate": "bun scripts/prisma-with-root-env.ts generate",
    "db:migrate": "bun scripts/prisma-with-root-env.ts migrate dev",
    "db:push": "bun scripts/prisma-with-root-env.ts db push",
    "import:bot-history": "bun --env-file=../../.env scripts/import-bot-history.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@k0ii/schemas": "workspace:*",
    "@prisma/client": "^6.19.0",
    "hono": "^4.11.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  }
}
